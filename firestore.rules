rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function signedIn() { return request.auth != null; }
    function fam(fid) { return /databases/$(database)/documents/families/$(fid); }
    function isMember(fid) {
      return signedIn() && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.auth.uid));
    }

    // ---------- Validaciones de forma y tamaño (el cliente ya las cumple; aquí se exigen de verdad) ----------
    function str(v, max) { return v is string && v.size() <= max; }

    // Contenido de una historia según su tipo. Fotos, dibujos y voz van como texto base64 (máx. ~850.000 caracteres).
    function xOk(k, x) {
      return x is map && (
        (k == 'voz'    && x.keys().hasOnly(['d', 'src', 'mime']) && str(x.get('d', ''), 12) && str(x.get('src', ''), 900000) && str(x.get('mime', ''), 60)) ||
        (k == 'foto'   && x.keys().hasOnly(['src', 'cap'])       && str(x.get('src', ''), 900000) && str(x.get('cap', ''), 300)) ||
        (k == 'dibujo' && x.keys().hasOnly(['src'])              && str(x.get('src', ''), 900000)) ||
        (k == 'carta'  && x.keys().hasOnly(['to', 'tx'])         && str(x.get('to', ''), 40) && str(x.get('tx', ''), 800)) ||
        (k == 'receta' && x.keys().hasOnly(['by', 'ing', 'stp']) && str(x.get('by', ''), 40) && x.get('ing', []) is list && x.get('ing', []).size() <= 60 && str(x.get('stp', ''), 4000))
      );
    }

    // Una historia nueva (familiar o del diario personal).
    function postOk() {
      let d = request.resource.data;
      return d.keys().hasOnly(['k', 't', 'x', 'by', 'authorUid', 'authorName', 'createdAt', 'rx0', 'rx1', 'rx2'])
        && d.keys().hasAll(['k', 't', 'x', 'authorUid', 'createdAt'])
        && d.k in ['voz', 'foto', 'carta', 'dibujo', 'receta']
        && d.authorUid == request.auth.uid
        && str(d.t, 120)
        && str(d.get('by', ''), 60)
        && str(d.get('authorName', ''), 40)
        && d.createdAt == request.time
        && d.get('rx0', []) == [] && d.get('rx1', []) == [] && d.get('rx2', []) == []
        && xOk(d.k, d.x);
    }

    // Una reacción solo puede añadir o quitar el uid de quien la hace.
    function onlyMine(nuevo, viejo) {
      return nuevo is list && nuevo.size() <= 200
        && nuevo.toSet().difference(viejo.toSet()).hasOnly([request.auth.uid])
        && viejo.toSet().difference(nuevo.toSet()).hasOnly([request.auth.uid]);
    }

    function petKindOk(v) { return v in ['nube', 'gato', 'perro', 'conejo', 'oso']; }

    // Campos de la ficha de miembro que cambian con el juego.
    function memberFieldsOk(d) {
      return str(d.name, 40)
        && petKindOk(d.petKind)
        && str(d.petName, 20)
        && d.xp is number && d.xp >= 0 && d.xp <= 10000000;
    }

    // Datos opcionales de la ficha de miembro (perfil y "activo hace"). Todos son opcionales.
    function memberExtraOk(d) {
      return (!('streak' in d) || (d.streak is number && d.streak >= 0 && d.streak <= 100000))
        && (!('total' in d) || (d.total is number && d.total >= 0 && d.total <= 1000000))
        && (!('wear' in d) || (d.wear is list && d.wear.size() <= 12))
        && (!('showSeen' in d) || d.showSeen is bool);
    }
    // Administrador: solo este correo verificado puede leer las estadísticas de uso.
    function isAdmin() {
      return signedIn() && request.auth.token.email_verified == true && request.auth.token.email == 'CORREO_ADMIN';
    }
    // Limpieza: el dueño de la cápsula, o cualquier miembro si el dueño ya no está (cápsula sin dueño), puede vaciarla y borrarla cuando se queda sin gente.
    function canClean(fid) {
      return isMember(fid) && (
        get(/databases/$(database)/documents/families/$(fid)).data.ownerUid == request.auth.uid
        || !exists(/databases/$(database)/documents/families/$(fid)/members/$(get(/databases/$(database)/documents/families/$(fid)).data.ownerUid)));
    }
    function typeOk(v) { return v in ['familia', 'pareja', 'amigos']; }

    // ---------- Progreso personal y diario individual (solo el dueño) ----------
    // Tope por escritura para Lumis y XP: no frena a quien repita la jugada, pero impide inflar el saldo de golpe desde la consola.
    function gainOk(campo, tope, maximo) {
      let nuevo = request.resource.data.get(campo, 0);
      let viejo = resource.data.get(campo, 0);
      return nuevo is number && nuevo >= 0 && nuevo <= maximo && (!(viejo is number) || nuevo <= viejo + tope);
    }

    match /users/{uid} {
      allow read, create, delete: if signedIn() && request.auth.uid == uid;
      // El nombre solo puede cambiar una vez cada 15 días: el cambio debe traer la hora del servidor y haber pasado ese tiempo desde el anterior.
      allow update: if signedIn() && request.auth.uid == uid
        && gainOk('lm', 1000, 200000) && gainOk('xp', 5000, 100000000)
        && (request.resource.data.get('name', '') == resource.data.get('name', '')
            && request.resource.data.get('ln', '') == resource.data.get('ln', '')
          || resource.data.get('name', '') == ''
          || (request.resource.data.get('nameAt', null) == request.time
            && (resource.data.get('nameAt', null) == null
              || request.time > resource.data.nameAt + duration.value(15, 'd'))));
      // Avisos push (se usan cuando se activa el servidor): cada dispositivo guarda su propio token.
      match /tokens/{tid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && tid.size() <= 400;
      }
      match /posts/{pid} {
        allow read, delete: if signedIn() && request.auth.uid == uid;
        allow create: if signedIn() && request.auth.uid == uid && pid.matches('[A-Za-z0-9]{20}') && postOk();
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx0', 'rx1', 'rx2']);
      }
    }

    // ---------- Reportes de contenido o de personas: cualquiera envía; solo el administrador lee y cierra ----------
    match /reports/{rid} {
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['by', 'fid', 'pid', 'tu', 'r', 'n', 't'])
        && request.resource.data.by == request.auth.uid
        && request.resource.data.fid is string && request.resource.data.fid.size() <= 40
        && request.resource.data.get('pid', '') is string && request.resource.data.get('pid', '').size() <= 40
        && request.resource.data.tu is string && request.resource.data.tu.size() <= 40
        && request.resource.data.r in ['sexual', 'violencia', 'acoso', 'privado', 'menor', 'otro']
        && request.resource.data.get('n', '') is string && request.resource.data.get('n', '').size() <= 300
        && request.resource.data.t == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- Cápsula Plus: solo el administrador (o, a futuro, un servidor de verificación) concede el plan; cada persona lee el suyo ----------
    // Alertas de ganancias sospechosas (las escribe el servidor; solo el administrador las lee)
    match /flags/{id} {
      allow read: if isAdmin();
    }

    match /entitlements/{uid} {
      allow read: if signedIn() && (request.auth.uid == uid || isAdmin());
      allow write: if isAdmin();
    }

    // ---------- Compras por verificar: la persona registra su compra; solo el administrador la lee y la cierra ----------
    match /purchases/{pid} {
      allow create: if signedIn() && request.resource.data.uid == request.auth.uid
        && request.resource.data.keys().hasOnly(['uid', 'sku', 'token', 'at'])
        && request.resource.data.sku is string && request.resource.data.sku.size() <= 40
        && request.resource.data.token is string && request.resource.data.token.size() <= 400
        && request.resource.data.at == request.time;
      allow read, delete: if isAdmin();
    }

    // ---------- Presencia anónima: solo la hora de la última vez. La lee únicamente el administrador ----------
    match /presence/{uid} {
      allow create, update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['t'])
        && request.resource.data.t == request.time;
      allow delete: if signedIn() && request.auth.uid == uid;
      allow read: if isAdmin();
    }

    // ---------- Invitaciones a la app: una por cuenta nueva (dentro de sus primeros 2 días) ----------
    match /referrals/{uid} {
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['by', 'createdAt'])
        && request.resource.data.by is string && request.resource.data.by.size() <= 40
        && request.resource.data.by != uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.by))
        && get(/databases/$(database)/documents/users/$(uid)).data.createdAt is timestamp
        && request.time < get(/databases/$(database)/documents/users/$(uid)).data.createdAt + duration.value(2, 'd');
      allow read: if signedIn() && (request.auth.uid == uid || resource.data.by == request.auth.uid);
      allow delete: if signedIn() && request.auth.uid == uid;
    }

    // ---------- Código de invitación -> familia. Se consulta uno por uno, no se puede listar ----------
    match /familyCodes/{code} {
      allow get: if signedIn();
      allow delete: if signedIn() && (resource.data.ownerUid == request.auth.uid || canClean(resource.data.familyId));
      // Al transferir la cápsula, el código pasa al nuevo dueño en la misma operación.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && getAfter(fam(resource.data.familyId)).data.ownerUid == request.resource.data.ownerUid;
      allow create: if signedIn()
        && code.matches('[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(['familyId', 'ownerUid'])
        && request.resource.data.ownerUid == request.auth.uid
        && getAfter(fam(request.resource.data.familyId)).data.code == code
        && getAfter(fam(request.resource.data.familyId)).data.ownerUid == request.auth.uid;
    }

    match /families/{fid} {
      allow read: if isMember(fid);
      allow create: if signedIn()
        && fid.matches('[A-Za-z0-9]{20}')
        && request.resource.data.ownerUid == request.auth.uid
        && request.resource.data.keys().hasOnly(['name', 'code', 'ownerUid', 'createdAt', 'type'])
        && (!('type' in request.resource.data) || typeOk(request.resource.data.type))
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && request.resource.data.code is string && request.resource.data.code.matches('[A-Z0-9]{8}')
        && request.resource.data.createdAt == request.time;
      // El dueño solo puede cambiar el nombre y la portada (foto pequeña, texto de hasta 100.000 caracteres).
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'cover', 'plan'])
        && (!('plan' in request.resource.data) || request.resource.data.plan == 'free' || (request.resource.data.plan == 'plus' && exists(/databases/$(database)/documents/entitlements/$(request.auth.uid)) && get(/databases/$(database)/documents/entitlements/$(request.auth.uid)).data.tier == 'plus'))
        && request.resource.data.name is string && request.resource.data.name.size() >= 1 && request.resource.data.name.size() <= 30
        && (!('cover' in request.resource.data) || (request.resource.data.cover is string && request.resource.data.cover.size() <= 100000 && request.resource.data.cover.matches('data:image/(jpeg|png|webp);base64,[A-Za-z0-9+/=]+')));
      // Renovar el código de invitación: solo el dueño y solo cambia el código (el anterior deja de servir).
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['code'])
        && request.resource.data.code is string && request.resource.data.code.matches('[A-Z0-9]{8}');
      // Transferir la cápsula: solo el dueño actual, solo cambia ownerUid y solo a alguien que ya es miembro.
      allow update: if signedIn() && resource.data.ownerUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ownerUid'])
        && request.resource.data.ownerUid is string
        && request.resource.data.ownerUid != request.auth.uid
        && exists(/databases/$(database)/documents/families/$(fid)/members/$(request.resource.data.ownerUid));
      allow delete: if canClean(fid);

      match /members/{uid} {
        allow read: if isMember(fid);
        // Entra el creador de la familia, o quien trae el código correcto.
        allow create: if signedIn() && request.auth.uid == uid
          && request.resource.data.keys().hasOnly(['name', 'petKind', 'petName', 'xp', 'photo', 'joinCode', 'joinedAt', 'streak', 'total', 'wear', 'showSeen', 'lastSeen', 'invBy'])
          && memberExtraOk(request.resource.data)
          && str(request.resource.data.get('invBy', ''), 40)
          && (!('lastSeen' in request.resource.data) || request.resource.data.lastSeen == request.time)
          && request.resource.data.keys().hasAll(['name', 'petKind', 'petName', 'xp', 'joinCode', 'joinedAt'])
          && memberFieldsOk(request.resource.data)
          && str(request.resource.data.get('photo', ''), 600)
          && (request.resource.data.get('photo', '') == '' || request.resource.data.get('photo', '').matches('https://[a-z0-9-]+\\.googleusercontent\\.com/.*'))
          && str(request.resource.data.joinCode, 8)
          && request.resource.data.joinedAt == request.time
          && (getAfter(fam(fid)).data.ownerUid == uid ||
              getAfter(fam(fid)).data.code == request.resource.data.joinCode);
        allow update: if signedIn() && request.auth.uid == uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['name', 'petKind', 'petName', 'xp', 'streak', 'total', 'wear', 'showSeen', 'lastSeen'])
          && memberFieldsOk(request.resource.data)
          && memberExtraOk(request.resource.data)
          && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['lastSeen']) || request.resource.data.lastSeen == request.time);
        // Cada persona puede salir; el dueño de la cápsula puede quitar a otra.
        allow delete: if signedIn() && (request.auth.uid == uid || get(fam(fid)).data.ownerUid == request.auth.uid);
      }

      // Pregunta del día: una respuesta por persona y día. Solo ves las de los demás cuando ya respondiste la tuya.
      match /qa/{day}/answers/{uid} {
        allow get: if isMember(fid) && (request.auth.uid == uid
          || exists(/databases/$(database)/documents/families/$(fid)/qa/$(day)/answers/$(request.auth.uid)));
        allow list: if isMember(fid)
          && exists(/databases/$(database)/documents/families/$(fid)/qa/$(day)/answers/$(request.auth.uid));
        allow create: if isMember(fid) && request.auth.uid == uid
          && day.matches('[0-9]{4}-[0-9]{2}-[0-9]{2}')
          && request.resource.data.keys().hasOnly(['tx', 'name', 'createdAt'])
          && str(request.resource.data.tx, 300) && request.resource.data.tx.size() >= 1
          && str(request.resource.data.name, 40)
          && request.resource.data.createdAt == request.time;
        allow delete: if isMember(fid) && (request.auth.uid == uid || canClean(fid));
      }

      // Historial de la familia.
      match /posts/{pid} {
        allow read: if isMember(fid);
        allow create: if isMember(fid) && pid.matches('[A-Za-z0-9]{20}') && postOk();
        allow update: if isMember(fid)
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['rx0', 'rx1', 'rx2'])
          && onlyMine(request.resource.data.get('rx0', []), resource.data.get('rx0', []))
          && onlyMine(request.resource.data.get('rx1', []), resource.data.get('rx1', []))
          && onlyMine(request.resource.data.get('rx2', []), resource.data.get('rx2', []));
        // Cada quien borra lo suyo; el administrador de la cápsula puede retirar cualquier historia (moderación).
        allow delete: if isMember(fid) && (resource.data.authorUid == request.auth.uid
          || canClean(fid));
      }
    }

    // ---------- Amigos y chat 1 a 1 ----------
    // Perfil público mínimo (nombre, mascota y código de amigo). Solo se lee uno por uno: no se puede listar a las personas.
    match /profiles/{uid} {
      allow get: if signedIn();
      allow create: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pet', 'fc'])
        && str(request.resource.data.name, 30) && request.resource.data.name.size() >= 1
        && str(request.resource.data.get('pet', ''), 12)
        && request.resource.data.fc is string && request.resource.data.fc.matches('[A-Z0-9]{8}');
      allow update: if signedIn() && request.auth.uid == uid
        && request.resource.data.keys().hasOnly(['name', 'pet', 'fc'])
        && str(request.resource.data.name, 30) && request.resource.data.name.size() >= 1
        && str(request.resource.data.get('pet', ''), 12)
        && request.resource.data.fc == resource.data.fc;
      allow delete: if signedIn() && request.auth.uid == uid;
    }
    // Código de amigo -> persona. Se consulta uno por uno.
    match /friendCodes/{code} {
      allow get: if signedIn();
      allow create: if signedIn() && code.matches('[A-Z0-9]{8}')
        && request.resource.data.keys().hasOnly(['uid'])
        && request.resource.data.uid == request.auth.uid
        && getAfter(/databases/$(database)/documents/profiles/$(request.auth.uid)).data.fc == code;
      allow delete: if signedIn() && resource.data.uid == request.auth.uid;
    }
    // Amistad entre dos personas. El id es los dos uid ordenados unidos por "_".
    // st: pending (invitación enviada), ok (amigos), blk (bloqueada por "by").
    match /friends/{pair} {
      allow read: if signedIn() && request.auth.uid in resource.data.u;
      allow create: if signedIn()
        && request.resource.data.keys().hasOnly(['u', 'from', 'st', 'ts'])
        && request.resource.data.u is list && request.resource.data.u.size() == 2
        && request.resource.data.u[0] < request.resource.data.u[1]
        && pair == request.resource.data.u[0] + '_' + request.resource.data.u[1]
        && request.auth.uid in request.resource.data.u
        && request.resource.data.from == request.auth.uid
        && request.resource.data.st == 'pending'
        && request.resource.data.ts == request.time;
      allow update: if signedIn() && request.auth.uid in resource.data.u && (
        // aceptar una invitación que me enviaron
        (resource.data.st == 'pending' && resource.data.from != request.auth.uid
          && request.resource.data.st == 'ok'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st']))
        // dejar el último mensaje a la vista
        || (resource.data.st == 'ok'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['lm', 'la', 'lb'])
          && request.resource.data.lb == request.auth.uid
          && request.resource.data.la == request.time
          && str(request.resource.data.lm, 80))
        // bloquear
        || (resource.data.st != 'blk'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['st', 'by'])
          && request.resource.data.st == 'blk'
          && request.resource.data.by == request.auth.uid)
      );
      // Cualquiera de los dos puede cancelar, rechazar o eliminar; solo quien bloqueó puede quitar el bloqueo.
      allow delete: if signedIn() && request.auth.uid in resource.data.u
        && (resource.data.st != 'blk' || resource.data.by == request.auth.uid);

      match /msgs/{mid} {
        allow read: if signedIn() && request.auth.uid in get(/databases/$(database)/documents/friends/$(pair)).data.u;
        allow create: if signedIn()
          && request.auth.uid in get(/databases/$(database)/documents/friends/$(pair)).data.u
          && get(/databases/$(database)/documents/friends/$(pair)).data.st == 'ok'
          && request.resource.data.keys().hasOnly(['f', 't', 'ts'])
          && request.resource.data.f == request.auth.uid
          && request.resource.data.t is string && request.resource.data.t.size() >= 1 && request.resource.data.t.size() <= 500
          && request.resource.data.ts == request.time;
        allow delete: if signedIn() && resource.data.f == request.auth.uid;
      }
    }
  }
}
